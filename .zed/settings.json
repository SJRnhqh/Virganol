{
  "languages": {
    "TypeScript": {
      "language_servers": [
        "!typescript-language-server",
        "vtsls",
        "oxfmt",
        "!oxlint",
        "..."
      ],
      "prettier": { "allowed": false },
      "formatter": {
        "language_server": { "name": "oxfmt" }
      },
      "format_on_save": "on"
    },
    "TSX": {
      "language_servers": [
        "!typescript-language-server",
        "vtsls",
        "oxfmt",
        "!oxlint",
        "..."
      ],
      "prettier": { "allowed": false },
      "formatter": {
        "language_server": { "name": "oxfmt" }
      },
      "format_on_save": "on"
    }
  }
}
