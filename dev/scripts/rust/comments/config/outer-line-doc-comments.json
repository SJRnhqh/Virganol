{
  "tolerance": "immediate",
  "adapter": "napi",
  "coverage": {
    "include": [
      "apps/desktop/src-tauri/src/commands/**/*.rs",
      "apps/desktop/src-tauri/src/container/**/*.rs",
      "apps/desktop/src-tauri/src/core/shared/**/*.rs",
      "apps/desktop/src-tauri/src/core/bot/**/*.rs",
      "dev/scripts/rust/comments/crates/**/*.rs"
    ],
    "exclude": ["**/mod.rs"]
  },
  "allowedAsciiTerms": ["ANSI", "Node-API", "API", "ASCII", "CLI", "JSONL", "JSON", "RUST_LOG", "Rust", "Span", "Tauri", "UTC", "Windows", "Ollama", "DeepSeek"]
}
