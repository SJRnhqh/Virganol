{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virganol",
  "version": "0.0.1",
  "identifier": "com.virganol.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @virganol/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @virganol/ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Virganol",
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "theme": "Light",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/virganol-agent"]
  }
}
