{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "arrowParens": "always",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "**/node_modules",
    "dist",
    "dist-ssr",
    "build",
    "target",
    "**/gen/schemas",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock",
    "Cargo.lock",
    "*.log",
    "*.min.js",
    "*.min.css",
    "*.generated.*",
    ".claude",
    ".arts",
    ".zed",
    ".vscode",
    ".idea",
    ".DS_Store",
    "target/"
  ]
}
